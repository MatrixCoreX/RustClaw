{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.invalid/prompts/schemas/transcript_revision.schema.json",
  "title": "TranscriptRevision",
  "description": "Schema for model-reviewed speech transcripts and their model-generated delivery message.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewed_text",
    "delivery_message",
    "qualified",
    "confidence",
    "reason"
  ],
  "properties": {
    "reviewed_text": {
      "type": "string",
      "minLength": 1
    },
    "delivery_message": {
      "type": "string",
      "minLength": 1
    },
    "qualified": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "reason": {
      "type": "string"
    }
  }
}
