{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.dev/schemas/skill-install-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_name", "version", "manifest_digest", "source_digest", "lockfile_digests", "adapter", "adapter_version", "platform", "artifacts", "launch", "sandbox_profile", "runtime_network", "protocol_smoke", "installed_at_unix"],
  "properties": {
    "schema_version": { "const": 1 },
    "skill_name": { "$ref": "#/$defs/name" },
    "version": { "type": "string", "minLength": 1 },
    "manifest_digest": { "$ref": "#/$defs/sha256" },
    "source_digest": { "$ref": "#/$defs/sha256" },
    "lockfile_digests": { "type": "object", "additionalProperties": { "$ref": "#/$defs/sha256" } },
    "adapter": { "$ref": "#/$defs/adapter" },
    "adapter_version": { "type": "string", "minLength": 1 },
    "platform": { "$ref": "#/$defs/platform" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "launch": { "$ref": "#/$defs/launch" },
    "sandbox_profile": { "$ref": "#/$defs/sandbox" },
    "runtime_network": { "type": "boolean" },
    "protocol_smoke": { "$ref": "#/$defs/protocolSmoke" },
    "installed_at_unix": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "adapter": { "enum": ["cargo", "python", "node", "go", "prebuilt", "generic_process", "http_json"] },
    "launcher": { "enum": ["native", "python", "node", "java", "dotnet", "process", "http_json"] },
    "sandbox": { "enum": ["required", "read_only", "workspace_write", "networked"] },
    "relativePath": { "type": "string", "minLength": 1, "not": { "pattern": "(^/|(^|/)\\.\\.(/|$)|\\\\)" } },
    "environmentName": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": { "enum": ["linux", "macos", "windows"] },
        "arch": { "enum": ["x86_64", "aarch64", "armv7"] },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "executable"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "executable": { "type": "boolean" }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launcher", "program", "program_scope", "args", "working_directory", "environment", "environment_allowlist"],
      "properties": {
        "launcher": { "$ref": "#/$defs/launcher" },
        "program": { "type": "string", "minLength": 1 },
        "program_scope": { "enum": ["package", "trusted_runtime"] },
        "args": { "type": "array", "items": { "type": "string" } },
        "working_directory": { "$ref": "#/$defs/relativePath" },
        "environment": { "type": "object", "additionalProperties": { "type": "string" } },
        "environment_allowlist": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/environmentName" } },
        "trusted_runtime_sha256": { "$ref": "#/$defs/sha256" },
        "trusted_runtime_version": { "type": "string", "minLength": 1 },
        "remote_endpoint": { "type": "string", "pattern": "^https://" }
      },
      "allOf": [
        {
          "if": { "properties": { "program_scope": { "const": "trusted_runtime" } } },
          "then": { "required": ["trusted_runtime_sha256", "trusted_runtime_version"] }
        },
        {
          "if": { "properties": { "launcher": { "const": "http_json" } } },
          "then": { "required": ["remote_endpoint"] }
        }
      ]
    },
    "protocolSmoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "passed", "request_id", "checked_at_unix"],
      "properties": {
        "protocol": { "const": "agent-jsonl-v1" },
        "passed": { "const": true },
        "request_id": { "type": "string", "minLength": 1 },
        "checked_at_unix": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
