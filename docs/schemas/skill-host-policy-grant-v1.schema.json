{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-runtime.dev/schemas/skill-host-policy-grant-v1.schema.json",
  "title": "Agent Runtime host-owned skill policy grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_name", "version", "semantic_contract_digest", "capabilities", "permissions", "risk_level", "auto_invocable", "requires_confirmation", "approval_source", "approved_at_unix"],
  "properties": {
    "schema_version": { "const": 1 },
    "skill_name": { "$ref": "#/$defs/name" },
    "version": { "type": "string", "minLength": 1 },
    "semantic_contract_digest": { "$ref": "#/$defs/sha256" },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "$ref": "#/$defs/capabilityName" }, "action": { "$ref": "#/$defs/name" } } } },
    "permissions": { "$ref": "skill-manifest-v2.schema.json#/$defs/permissions" },
    "risk_level": { "enum": ["low", "medium", "high"] },
    "auto_invocable": { "type": "boolean" },
    "requires_confirmation": { "type": "boolean" },
    "approval_source": { "enum": ["release_baseline", "operator", "admin_api", "policy_automation", "migration"] },
    "approved_at_unix": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$" },
    "capabilityName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)*$" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
  }
}
