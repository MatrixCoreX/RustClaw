schema_version = 1

[package]
name = "reference_prebuilt"
version = "1.0.0"
description = "Cross-language reference conformance fixture"
protocol = "agent-jsonl-v1"
supported_os = ["@OS@"]
supported_arch = ["@ARCH@"]
license = "MIT"

[registry]
name = "reference_prebuilt"
capability_policy_source = "registry"

[build]
adapter = "prebuilt"
source_root = "prebuilt"
network = "deny"

[[build.artifacts]]
os = "@OS@"
arch = "@ARCH@"
sha256 = "@SHA256@"
source_path = "skill.py"
executable = true

[run]
launcher = "native"
entrypoint = "runtime/bin/reference-prebuilt-skill"
working_directory = "."
timeout_seconds = 10
smoke_args = { action = "calculate", a = 1, b = 2 }

[security]
capability_policy_source = "registry"
sandbox = "required"
runtime_network = false
inherit_credentials = false

[storage]
kind = "none"
schema_version = 1
migration_owner = "reference_prebuilt"

[lifecycle]
preserve_data_on_uninstall = true
update_strategy = "atomic_replace"
