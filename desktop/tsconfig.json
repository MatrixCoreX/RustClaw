{
  "extends": "../UI/tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "../UI/node_modules/@types"],
    "paths": {
      "react": ["../UI/node_modules/@types/react"],
      "react/*": ["../UI/node_modules/@types/react/*"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@tauri-apps/api/*": ["./node_modules/@tauri-apps/api/*"]
    }
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx", "../UI/src/vite-env.d.ts"],
  "exclude": ["node_modules", "dist", "target"]
}
