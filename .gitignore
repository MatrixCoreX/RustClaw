# =============================================================================
# Secrets — files containing real API keys / tokens / app_secrets.
# Track *.example variants instead. After clone, copy *.example to the real
# filename and fill in real credentials locally.
# =============================================================================
configs/map_merchant.toml
configs/channels/feishu.toml
docker/config/channels/feishu.toml
docker/config/channels/telegram.toml

# Generic env files (never tracked)
.env
.env.local
.env.*.local
*.env
runtime_env*.sh
configs/*.toml.lock

# =============================================================================
# Per-session probes / scratch test sets that shouldn't bake into the repo.
# Underscore-prefixed dirs under nl_tests/cases are reserved for ad-hoc probes
# (one-off probe_chat, ephemeral micro-suites). Curated regression sets live
# under scripts/nl_tests/cases/ without an underscore prefix.
# =============================================================================
scripts/nl_tests/cases/_probe/
scripts/nl_tests/cases/_tmp_*.txt

# =============================================================================
# Cursor / agent transcripts
# =============================================================================
/AGENTS.md
.cursor/
agent-transcripts/
tmp/
.pids/
